# ---- Gestionale magazzino speleo ----

Options -Indexes
DirectoryIndex index.php

# I file dei dati non si scaricano dal browser
<FilesMatch "\.(json|lock|tmp|md)$">
  Require all denied
</FilesMatch>

# Niente accesso diretto ai file inclusi
RedirectMatch 404 ^/.*/inc/.*$

# Intestazioni di sicurezza (se mod_headers e' attivo)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "same-origin"
</IfModule>

# Forza HTTPS: togli il commento quando il certificato e' attivo
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# </IfModule>
